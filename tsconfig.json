{
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "bundler",
		"target": "ES2022",
		"rootDir": ".",
		"types": ["node"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"isolatedModules": true,
		"allowSyntheticDefaultImports": true,
		"skipLibCheck": true,
		"useUnknownInCatchVariables": true,
		"verbatimModuleSyntax": true,
		"lib": ["DOM", "ES2022"]
	},
	"include": ["src/**/*.ts", "vite.config.ts"]
}
